{
  "name": "cricket-draft-challenge",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered Cricket XI drafting game with deterministic constraint solver, real-time draft rooms, and hybrid scoring.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc --noEmit",
    "etl:download": "tsx src/etl/download-cricsheet.ts",
    "etl:process": "tsx src/etl/process-cricsheet.ts",
    "db:migrate:local": "wrangler d1 execute cricdraft-db --local --file=src/db/schema.sql",
    "etl:career": "tsx src/etl/career-overrides.ts",
    "db:seed:local": "wrangler d1 execute cricdraft-db --local --file=data/seed.sql && wrangler d1 execute cricdraft-db --local --file=data/career-overrides.sql"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "@types/node": "^22.10.2",
    "csv-parse": "^7.0.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wrangler": "^4.157.0"
  }
}
