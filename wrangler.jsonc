{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cricket-draft-challenge",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cricdraft-db",
      "database_id": "local-cricdraft-db"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "DRAFT_ROOM",
        "class_name": "DraftRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["DraftRoom"]
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  }
}

